{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"%CLAUDE_PROJECT_DIR%\\cyhi-logs\\bin\\cyhi.bat\" session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"%CLAUDE_PROJECT_DIR%\\cyhi-logs\\bin\\cyhi.bat\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"%CLAUDE_PROJECT_DIR%\\cyhi-logs\\bin\\cyhi.bat\" session-end",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
